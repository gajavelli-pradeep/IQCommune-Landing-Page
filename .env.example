# =====================================
# BREVO EMAIL API CONFIGURATION
# =====================================
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Admin / Internal Team Email (Where new request alerts are sent)
ADMIN_NOTIFICATION_EMAIL=hello@iqcommune.com

# Sender / From Email (Shown to customers/users in their inbox)
BREVO_SENDER_EMAIL=hello@iqcommune.com
BREVO_SENDER_NAME="InvestQ Commune"

# Toggle sending automated Thank You emails to customers/users (true or false)
ENABLE_CUSTOMER_THANK_YOU_EMAIL=true

# =====================================
# SUPABASE DATABASE CONFIGURATION
# =====================================
# Get your Project URL & Keys from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
